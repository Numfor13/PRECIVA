{
  "info": {
    "name": "Cart API",
    "_postman_id": "c1111aaa-2222-bbbb-3333-cccc4444dddd",
    "description": "Postman collection for Cart API testing with user token authentication.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add to Cart",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/cart/add",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "cart", "add"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
        }
      }
    },
    {
      "name": "Get My Cart",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/cart",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "cart"]
        }
      }
    },
    {
      "name": "Update Cart Item Quantity",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/cart/update",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "cart", "update"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 3\n}"
        }
      }
    },
    {
      "name": "Remove Item from Cart",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/cart/remove/{{productId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "cart", "remove", "{{productId}}"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ]
}
