{
  "info": {
    "name": "Order API Collection",
    "_postman_id": "ecommerce-order-api",
    "description": "Test collection for Order API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Place Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{USER_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/orders/place",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders", "place"]
        }
      }
    },
    {
      "name": "Pay for Order",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{USER_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/orders/:id/pay",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders", ":id", "pay"]
        }
      }
    },
    {
      "name": "Update Order Status (Admin)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ADMIN_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/orders/:id/status",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders", ":id", "status"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Shipped\"\n}"
        }
      }
    },
    {
      "name": "Get My Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{USER_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/orders/my-orders",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders", "my-orders"]
        }
      }
    },
    {
      "name": "Get All Orders (Admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ADMIN_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/orders",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders"]
        }
      }
    },
    {
      "name": "Get Order by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{USER_TOKEN}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/api/orders/:id",
          "host": ["{{BASE_URL}}"],
          "path": ["api", "orders", ":id"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000"
    },
    {
      "key": "USER_TOKEN",
      "value": ""
    },
    {
      "key": "ADMIN_TOKEN",
      "value": ""
    }
  ]
}
