{
  "info": {
    "name": "Preciva - Product API",
    "_postman_id": "12345678-abcd-efgh-ijkl-1234567890ab",
    "description": "Collection for testing Product API routes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Add Product (Admin only)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop\",\n  \"price\": 1200,\n  \"description\": \"High performance laptop\",\n  \"category\": \"Electronics\",\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/product/add",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "product", "add"]
        }
      }
    },
    {
      "name": "Get All Products",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/api/product/list",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "product", "list"]
        }
      }
    },
    {
      "name": "Get Product by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/api/product/{{productId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "product", "{{productId}}"]
        }
      }
    },
    {
      "name": "Update Product (Admin only)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 1500,\n  \"stock\": 5\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/product/{{productId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "product", "{{productId}}"]
        }
      }
    },
    {
      "name": "Delete Product (Admin only)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "http://localhost:5000/api/product/{{productId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "product", "{{productId}}"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    }
  ]
}
